# Copie ce fichier en .env (jamais commité, voir .gitignore) après avoir
# créé l'External Client App côté Salesforce — voir README.md, section
# "Brancher un vrai sandbox Salesforce" pour la procédure complète.

# --- Flow par défaut : client_credentials (Consumer Key + Secret + Run As User) ---
SF_AUTH_FLOW=client_credentials

# Consumer Key de l'External Client App
SF_CLIENT_ID=

# Consumer Secret de l'External Client App (uniquement nécessaire pour
# client_credentials — jamais commité, jamais log)
SF_CLIENT_SECRET=

# IMPORTANT pour client_credentials : ça doit être le *My Domain* de ton
# org, pas login.salesforce.com/test.salesforce.com. Exemple :
# https://mon-org--nomdusandbox.sandbox.my.salesforce.com
SF_LOGIN_URL=

# --- Uniquement si SF_AUTH_FLOW=jwt (voir README) ---
# Utilisateur "au nom de qui" le JWT s'authentifie
# SF_USERNAME=integration.user@monsandbox.example.com
# Chemin vers la clé privée .pem qui a signé le certificat uploadé sur l'app
# SF_PRIVATE_KEY_PATH=./certs/server.key

# Optionnel : décommenter pour activer le vrai jugement LLM (sinon mode
# heuristique/démo dans judge.py)
# ANTHROPIC_API_KEY=
